\"129\": \"Запоминать сумму последнего пари\",\n        \"130\": \"Автоматически принимать изменения коэффициентов\",\n        \"131\": \"Настройки купона\",\n        \"132\": \"Настройки купона сохранены\",\n        \"133\": \"Одиночные\",\n        \"134\": \"Вы хотите удалить все исходы и очистить купон?\",\n        \"135\": \"Удалить исходы\",\n        \"136\": \"Достигнут максимальный размер купона\",\n        \"137\": \"Этот исход нельзя комбинировать с другими\",\n        \"138\": \"Вы хотите очистить купон и добавить выбранный исход?\",\n        \"139\": \"В купоне есть исход, который нельзя комбинировать с другими.\",\n        \"140\": \"Вы хотите очистить купон и добавить выбранный исход?\",\n        \"141\": \"Исход временно снят с приема\",\n        \"142\": \"Исход снят с приема\",\n        \"144\": \"Исход заблокирован\",\n        \"145\": \"От\",\n        \"146\": \"до\",\n        \"147\": \"Принять изменения\",\n        \"148\": \"Все события завершены, исходы будут удалены\",\n        \"149\": \"Рубли\",\n        \"151\": \"Недостаточно средств на счете\",\n        \"150\": \"Максимальная сумма пари (не VIP)\",\n        \"153\": \"Минимальная сумма пари\",\n        \"154\": \"Максимальный выигрыш\",\n        \"155\": \"Заключено {{count}} пари\",\n        \"156\": \"Принять изменения в кф и отправить заявку\",\n        \"157\": \"Пари заключено\",\n        \"158\": \"Ожидание подтверждения ~ 10 мин.<br>\\r\\nМоментальный возврат средств в случае отклонения заявки\",\n        \"159\": \"Принять изменения в кф и заключить пари\",\n        \"160\": \"Заявка отправлена\",\n        \"161\": \"Пари не найдено\",\n        \"162\": \"Мы переименовали раздел «Корзина» в «Купон»\",\n        \"163\": \"Купон отображается, когда в него добавлен хотя бы один исход\",\n        \"164\": \"В купоне показана вся информация о ходе события\",\n        \"165\": \"Пари можно заключить, находясь в списке событий или карточке события\",\n        \"166\": \"А можно свернуть