ight:320px;padding:60px 20px 20px}@media(max-width: 767px){.splash-container{max-height:calc(700px + 30vw)}}@media(max-height: 767px){.splash-container{padding:30px 20px 20px}}@media(max-height: 576px){.splash-container{padding:20px}}@media(max-height: 400px){.splash-container{padding:15px 20px 10px}}@media(max-height: 400px){.splash-container_en{padding:15px 20px}}.splash-container_en .splash-body__text{background-image:url(\"https://mcdn.betcity.ru/assets/images/svg/preloader/betcity-logo.svg?1\")}.splash-container_en .splash-footer__note{display:none}.splash-container_en .splash-loader{margin:0 auto}.splash-body{display:flex;flex-flow:row nowrap;flex-shrink:0;align-items:flex-end;justify-content:center;height:45%;padding:30px 0}@media(max-height: 400px){.splash-body{padding:20px 0}}.splash-body__text{width:100%;max-width:895px;height:100%;background:url(\"https://mcdn.betcity.ru/assets/images/svg/preloader/betcity-logo.svg\") no-repeat center;background-size:280px}@media(max-width: 1199px){.splash-body__text{max-width:780px}}@media(max-width: 1024px){.splash-body__text{max-width:656px}}.splash-footer{display:flex;justify-content:center;flex-direction:column;flex-shrink:0;flex-grow:1;width:100%}.splash-footer__text{flex-shrink:0;height:12px;margin:12px 0}@media(max-height: 400px){.splash-footer__text{height:10px;margin:10px 0}}@media(max-height: 359px){.splash-footer__text{margin:8px 0}}.splash-footer__note{flex-shrink:0;height:14px;margin-top:auto}@media(max-height: 400px){.splash-footer__note{height:12px}}.splash-loader{position:relative;flex-shrink:0;width:100%;height:2px;max-width:312px;margin:auto auto 76px;line-height:0;background:#4098c6;border-radius:4px;overflow:hidden}@media(max-width: 600px){.splash-loader{max-width:240px}}@media(max-width: 359px){.splash-loader{max-width:201px}}@media(max-height: 576px){.splash-loader{max-width:240px}}@media(max-height: 400px){.splash-loader{max-width:200px}}.splash-loader__progress{position:relative;top:-2px;z-index:2