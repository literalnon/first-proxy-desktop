cept-Encoding"},{"name":"Last-Modified","value":"Wed, 02 Jul 2025 19:33:10 GMT"},{"name":"Vary","value":"Accept-Encoding"},{"name":"ETag","value":"W/\"68658976-2acb2\""},{"name":"Expires","value":"Thu, 02 Jul 2026 20:23:26 GMT"},{"name":"Cache-Control","value":"max-age=31536000"},{"name":"X-Frame-Options","value":"DENY"},{"name":"X-Content-Type-Options","value":"nosniff"},{"name":"X-XSS-Protection","value":"1; mode=block"},{"name":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"name":"Strict-Transport-Security","value":"max-age=31536000"},{"name":"Access-Control-Allow-Origin","value":"https://m.betcity.ru"},{"name":"Access-Control-Allow-Methods","value":"GET"},{"name":"Access-Control-Allow-Credentials","value":"true"},{"name":"X-NGENIX-Cache","value":"HIT"},{"name":"Content-Length","value":"175282"}],"content":{"size":175282,"mimeType":"application/json","text":"{\n    \"404\": {\n        \"10\": \"Opera\",\n        \"11\": \"Mozilla Firefox\",\n        \"12\": \"Яндекс.Браузер\",\n        \"14\": \"Неверные параметры\",\n        \"15\": \"Попробуйте начать с\",\n        \"16\": \"главной страницы\",\n        \"3\": \"Страница, на которую вы хотели попасть, не существует.\",\n        \"4\": \"Попробуйте начать с <a href=\\\"/\\\">главной страницы</a>\",\n        \"5\": \"Ваш браузер не поддерживается\",\n        \"6\": \"Your browser is not supported\",\n        \"7\": \"Данная версия браузера не поддерживает многие современные технологии, из-за чего страницы могут отображаются некорректно и работают не все функции сайта. <br />Пожалуйста обновите ваш браузер до актуальной версии которые доступны по ссылкам ниже:\",\n        \"8\": \"This version of the browser does not support many of today's technology, which is why pages may not appear correctly and not all functions of the site.<br />Please upgrade your browser to the latest version available on the links below:\",\n        \"9\": \"Google Chrome\",\n        \"13\": \"Link will open in a new window\",\n        \"2\": \"Страница не найдена\",\n        \"18\": \"Событие не найдено\",\n        \"1\": \"404\",\n        \"19\": \"Перейти на главную\",\n        \"17\": \"Событие не найдено\",\n        \"test\": \"test\",\n        \"testetes\": \"testestset\",\n        \"test_hi\": \"test_hi\"\n    },\n    \"ms_main\": {\n        \"2\": \"О компании\",\n        \"3\": \"Пункты приема ставок\",\n        \"4\": \"Результаты\",\n        \"7\": \"Выход\",\n        \"8\": \"Адреса пунктов приема ставок\",\n        \"9\": \"режим работы указан по местному времени\",\n        \"10\": \"Новости компании\",\n        \"13\": \"Текущие\",\n        \"14\": \"Долгосрочные\",\n        \"15\": \"Показать\",\n        \"17\": \"Настройки\",\n        \"18\": \"Live-календарь\",\n        \"16\": \"Live-пари\",\n        \"20\": \"Корзина\",\n        \"5\": \"Live-результаты\",\n        \"22\": \"Баланс\",\n        \"23\": \"Текущие пари\",\n        \"26\": \"Ошибка при обработке данных.\",\n        \"28\": \"Пополните счет.\",\n        \"30\": \"Регистрация\",\n        \"31\": \"Пароль\",\n        \"34\": \"Нет результатов в соответствии с выбранным фильтром.\",\n        \"35\": \"Пари\",\n        \"36\": \"Сохранить\",\n        \"37\": \"Быстрое пари\",\n        \"39\": \"Не менее\",\n        \"41\": \"Приём пари в перерыве матча\",\n        \"43\": \"Вы действительно хотите совершить быстрое пари\",\n        \"44\": \"Ошибка при получении данных\",\n        \"46\": \"никогда\",\n        \"47\": \"всегда\",\n        \"49\": \"Пополнить\",\n        \"50\": \"Создать заявку\",\n        \"53\": \"минимум\",\n        \"54\": \"максимум\",\n        \"57\": \"Комиссия\",\n        \"59\": \"Вам выставлен счет. После его оплаты деньги будут зачислены на ваш счет.\",\n        \"60\": \"Ваша заявка принята.\",\n        \"61\": \"Текущее очко\",\n        \"62\": \"Текущий гейм\",\n        \"63\": \"Настройки сохранены\",\n        \"38\": \"Для оформления Быстрого пари введите его сумму и нажмите на коэффициент спортивного события.\",\n        \"64\": \"Неправильный логин и/или пароль\",\n        \"66\": \"Далее\",\n        \"70\": \"Вы успешно зарегистрировались!<br>Номер Вашего счета: {{ouser}}\",\n        \"48\": \"Поле \\\"{{field}}\\\" обязательно для заполнения\",\n        \"51\": \"Значение поля \\\"{{field}}\\\" меньше минимального ({{value}}).\",\n        \"52\": \"Значение поля \\\"{{field}}\\\" больше максимального ({{value}}).\",\n        \"55\": \"В поле \\\"{{field}}\\\" длина меньше минимально допустимой ({{value}}).\",\n        \"56\": \"В поле \\\"{{field}}\\\" длина больше максимально допустимой ({{value}}).\",\n        \"72\": \"BETCITY - букмекерская контора\",\n        \"74\": \"Промо-акции\",\n        \"75\": \"Ошибка соединения с интернетом. Пожалуйста, проверьте свое подключение.\",\n        \"76\": \"Как совершать интерактивные ставки\",\n        \"77\": \"Акции\",\n        \"78\": \"Расчеты\",\n        \"79\": \"Live-help\",\n        \"80\": \"Информация\",\n        \"81\": \"Для пополнения счета необходимо ввести дополнительные данные\",\n        \"82\": \"все время\",\n        \"83\": \"ближайший час\",\n        \"84\": \"ближайшие 2 часа\",\n        \"85\": \"ближайшие 4 часа\",\n        \"87\": \"ближайшие 12 часов\",\n        \"88\": \"ближайшие 24 часа\",\n        \"89\": \"ближайшие 48 часов\",\n        \"90\": \"Логин\",\n        \"91\": \"Войти\",\n        \"92\": \"Счет\",\n        \"94\": \"Номер счета\",\n        \"95\": \"Любимые пари\",\n        \"97\": \"Снятие со счета\",\n        \"98\": \"от\",\n        \"99\": \"до\",\n        \"100\": \"Без<br>комиссии\",\n        \"101\": \"Комиссия\",\n        \"102\": \"Мгновенное<br>зачисление\",\n        \"103\": \"до {{daysCount}} рабочих<br>дней\",\n        \"104\": \"Все\",\n        \"105\": \"Победитель\",\n        \"106\": \"С правилами согласен\",\n        \"107\": \"Все исходы\",\n        \"108\": \"Внимание! Вывод средств недоступен, так как не выполнены условия предоставления бонуса. Вам осталось совершить ставки, соответствующие условиям, на сумму не менее\",\n        \"109\": \"Доступный баланс:\",\n        \"29\": \"Вход\",\n        \"19\": \"Вход\",\n        \"112\": \"Зарегистрироваться\",\n        \"115\": \"Часовой пояс\",\n        \"116\": \"Видеотрансляция\",\n        \"117\": \"Для просмотра видео необходимо пройти авторизацию\",\n        \"118\": \"Закрыть\",\n        \"124\": \"Мобильное приложение позволит Вам заключать пари с мобильных устройств iPhone и iPad.\",\n        \"126\": \"BETCITY - iOS\",\n        \"27\": \"Ошибка при верификации.\",\n        \"130\": \"Пароли не совпадают\",\n        \"131\": \"Сохранить логин\",\n        \"133\": \"Забыли пароль?\",\n        \"134\": \"Назад\",\n        \"135\": \"Десятичный\",\n        \"136\": \"Английский\",\n        \"137\": \"Американский\",\n        \"138\": \"Вид коэффициентов\",\n        \"140\": \"Обновить страницу\",\n        \"141\": \"Перезагрузите страницу для завершения обновления.\",\n        \"142\": \"правила\",\n        \"42\": \"Прием пари окончен\",\n        \"143\": \"Страница не найдена\",\n        \"144\": \"Страница, на которую вы хотите попасть, не существует.\",\n        \"145\": \"Попробуйте начать\",\n        \"146\": \"с главной страницы\",\n        \"128\": \"Apple App Store\",\n        \"147\": \"Правила\",\n        \"148\": \"Поиск\",\n        \"150\": \" Уважаемый клиент! Ваш паспорт числится в списке недействительных. Предоставьте, пожалуйста, Ваши актуальные паспортные данные, направив скан-копию 1,2 и 5 страниц паспорта на почту support@betcity.ru.\",\n        \"152\": \"события\",\n        \"153\": \"Строка поиска должна быть более 3-х символов\",\n        \"154\": \"Нет совпадений по данному запросу\",\n        \"155\": \"Избранное\",\n        \"156\": \"У вас нет избранного\",\n        \"149\": \"Найти\",\n        \"157\": \"Не поддерживается на данном устройстве\",\n        \"86\": \"ближайшие 6 часов\",\n        \"158\": \"Выигрышные\",\n        \"159\": \"Проигрышные\",\n        \"161\": \"Сортировать события\",\n        \"163\": \"По популярности\",\n        \"165\": \"По времени начала\",\n        \"166\": \"Матчи с видеотрансляцией\",\n        \"167\": \"Активировать\",\n        \"169\": \"Показаны события на\",\n        \"170\": \"Ставки онлайн на \",\n        \"164\": \"По алфавиту\",\n        \"162\": \"Показать события за\",\n        \"171\": \"VIP-пари\",\n        \"172\": \"Проверка...\",\n        \"173\": \"Следующее СМС сообщение  можно будет получить через\",\n        \"175\": \"Место в рейтинге: \",\n        \"176\": \"Баллы: \",\n        \"114\": \"Акции\",\n        \"177\": \"Бонус\",\n        \"178\": \"Графика\",\n        \"179\": \"Событий с долгосрочными пари в выбранных видах спорта нет\",\n        \"180\": \"Событий с пари в выбранных видах спорта нет\",\n        \"181\": \"Показать все\",\n        \"183\": \"Ф\",\n        \"184\": \"К1\",\n        \"185\": \"К2\",\n        \"186\": \"TOT\",\n        \"187\": \"M\",\n        \"188\": \"Б\",\n        \"189\": \"Доп\",\n        \"190\": \"Выбранные\",\n        \"193\": \"Только дополнительные исходы &#9658;\",\n        \"194\": \"Наша организация не несёт ответственности за неточности в представленных статистических данных и результатах. Пользуйтесь, пожалуйста, независимыми источниками информации.\",\n        \"195\": \"Показывать тестовые события да/нет\",\n        \"200\": \"Сейчас\",\n        \"201\": \"Скоро\",\n        \"202\": \"Популярное\",\n        \"203\": \"Нажмите на\",\n        \"204\": \"рядом с интересующим вас событием для добавления его в избранное\",\n        \"205\": \"Виды спорта\",\n        \"206\": \"ближайшие 3 часа\",\n        \"207\": \"события за\",\n        \"209\": \"Для выполнения этого действия необходимо авторизоваться\",\n        \"210\": \"Пункты приема\",\n        \"212\": \"Ответственная игра\",\n        \"213\": \"Обратная связь\",\n        \"215\": \"Проблемы с доступом?\",\n        \"216\": \"Telegram-Бот\",\n        \"217\": \"Неверные параметры\",\n        \"218\": \"Сортировать\",\n        \"192\": \"Приём пари временно остановлен\",\n        \"219\": \"Страница\",\n        \"220\": \"Нет данных.\",\n        \"221\": \"Выберите часовой пояс\",\n        \"222\": \"Все события\",\n        \"224\": \"Новое приложение для компьютеров дает целый ряд преимуществ, в числе которых надежный доступ, высокая скорость работы с линией и лайвом, экономия трафика.\",\n        \"227\": \"Инструкция по установке\",\n        \"228\": \"Десятичные коэф.\",\n        \"229\": \"Английские коэф.\",\n        \"230\": \"Американские коэф.\",\n        \"231\": \"Книга замечаний и предложений\",\n        \"232\": \"Показать другие цифры\",\n        \"233\": \"Ваше сообщение отправлено. \",\n        \"234\": \"Отправить\",\n        \"235\": \"гостевой вход\",\n        \"236\": \"для ознакомления с системой используйте гостевой вход\",\n        \"237\": \"Пройдите проверку для получения гостевого аккаунта\",\n        \"238\": \"Вход в Гостевой счет выполнен.\",\n        \"239\": \"(запишите или запомните их)\",\n        \"240\": \"Ваш логин:\",\n        \"241\": \"Ваш пароль:\",\n        \"122\": \"Для установки на Ваш смартфон или планшет полного приложения <span>BETCITY - iOS</span> нажмите на кнопку «Apple App Store»\",\n        \"242\": \"Если у вас есть вопросы или предложения к администрации BETCITY, с этой страницы вы можете отправить сообщение,<br />и если вы укажите свой обратный адрес (e-mail), то вам обязательно ответят\",\n        \"69\": \"Вы успешно зарегистрировались!<br>Номер Вашего счета: {{ouser}}<br><br>На введенный Вами e-mail выслано письмо с ссылкой для активации Вашего счета.<br><br>Спасибо за регистрацию.<br>\\r\\n<br>Персональные данные необходимо вносить в строгом соответствии с документом, удостоверяющим личность (паспорт РФ). \",\n        \"245\": \"событие отменено\",\n        \"246\": \"Блог\",\n        \"247\": \"Мы в соцсетях\",\n 