Cache-Control","value":"max-age=31536000"},{"name":"X-Frame-Options","value":"DENY"},{"name":"X-Content-Type-Options","value":"nosniff"},{"name":"X-XSS-Protection","value":"1; mode=block"},{"name":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"name":"Strict-Transport-Security","value":"max-age=31536000"},{"name":"Access-Control-Allow-Origin","value":"https://betcity.ru"},{"name":"Access-Control-Allow-Methods","value":"GET"},{"name":"Access-Control-Allow-Credentials","value":"true"},{"name":"X-NGENIX-Cache","value":"MISS"},{"name":"Content-Length","value":"176200"}],"content":{"size":176200,"mimeType":"application/json","text":"{\n    \"404\": {\n        \"10\": \"Opera\",\n        \"11\": \"Mozilla Firefox\",\n        \"12\": \"Яндекс.Браузер\",\n        \"14\": \"Неверные параметры\",\n        \"15\": \"Попробуйте начать с\",\n        \"16\": \"главной страницы\",\n        \"3\": \"Страница, на которую вы хотели попасть, не существует.\",\n        \"4\": \"Попробуйте начать с <a href=\\\"/\\\">главной страницы</a>\",\n        \"5\": \"Ваш браузер не поддерживается\",\n        \"6\": \"Your browser is not supported\",\n        \"7\": \"Данная версия браузера не поддерживает многие современные технологии, из-за чего страницы могут отображаются некорректно и работают не все функции сайта. <br />Пожалуйста обновите ваш браузер до актуальной версии которые доступны по ссылкам ниже:\",\n        \"8\": \"This version of the browser does not support many of today's technology, which is why pages may not appear correctly and not all functions of the site.<br />Please upgrade your browser to the latest version available on the links below:\",\n        \"9\": \"Google Chrome\",\n        \"13\": \"Link will open in a new window\",\n        \"2\": \"Страница не найдена\",\n        \"18\": \"Событие не найдено\",\n        \"1\": \"404\",\n        \"19\": \"Перейти на главную\",\n        \"17\": \"Событие не найдено\",\n        \"test\": \"test\",\n        \"testetes\": \"testestset\",\n        \"test_hi\": \"test_hi\"\n    },\n    \"ms_main\": {\n        \"2\": \"О компании\",\n        \"3\": \"Пункты приема ставок\",\n        \"4\": \"Результаты\",\n        \"7\": \"Выход\",\n        \"8\": \"Адреса пунктов приема ставок\",\n        \"9\": \"режим работы указан по местному времени\",\n        \"10\": \"Новости компании\",\n        \"13\": \"Текущие\",\n        \"14\": \"Долгосрочные\",\n        \"15\": \"Показать\",\n        \"17\": \"Настройки\",\n        \"18\": \"Live-календарь\",\n        \"16\": \"Live-пари\",\n        \"20\": \"Корзина\",\n        \"5\": \"Live-результаты\",\n        \"22\": \"Баланс\",\n        \"23\": \"Текущие пари\",\n        \"26\": \"Ошибка при обработке данных.\",\n        \"28\": \"Пополните счет.\",\n        \"30\": \"Регистрация\",\n        \"31\": \"Пароль\",\n        \"34\": \"Нет результатов в соответствии с выбранным фильтром.\",\n        \"35\": \"Пари\",\n        \"36\": \"Сохранить\",\n        \"37\": \"Быстрое пари\",\n        \"39\": \"Не менее\",\n        \"41\": \"Приём пари в перерыве матча\",\n        \"43\": \"Вы действительно хотите совершить быстрое пари\",\n        \"44\": \"Ошибка при получении данных\",\n        \"46\": \"никогда\",\n        \"47\": \"всегда\",\n        \"49\": \"Пополнить\",\n        \"50\": \"Создать заявку\",\n        \"53\": \"минимум\",\n        \"54\": \"максимум\",\n        \"57\": \"Комиссия\",\n        \"59\": \"Вам выставлен счет. После его оплаты деньги будут зачислены на ваш счет.\",\n        \"60\": \"Ваша заявка принята.\",\n        \"61\": \"Текущее очко\",\n        \"62\": \"Текущий гейм\",\n        \"63\": \"Настройки сохранены\",\n        \"38\": \"Для оформления Быстрого пари введите его сумму и нажмите на коэффициент спортивного события.\",\n        \"64\": \"Неправильный логин и/или пароль\",\n        \"66\": \"Далее\",\n        \"70\": \"Вы успешно зарегистрировались!<br>Номер Вашего счета: {{ouser}}\",\n        \"48\": \"Поле \\\"{{field}}\\\" обязательно для заполнения\",\n        \"51\": \"Значение поля \\\"{{field}}\\\" меньше минимального ({{value}}).\",\n        \"52\": \"Значение поля \\\"{{field}}\\\" больше максимального ({{value}}).\",\n        \"55\": \"В поле \\\"{{field}}\\\" длина меньше минимально допустимой ({{value}}).\",\n        \"56\": \"В поле \\\"{{field}}\\\" длина больше максимально допустимой ({{value}}).\",\n        \"72\": \"BETCITY - букмекерская контора\",\n        \"74\": \"Промо-акции\",\n        \"75\": \"Ошибка соединения с интернетом. Пожалуйста, проверьте свое подключение.\",\n        \"76\": \"Как совершать интерактивные ставки\",\n        \"77\": \"Акции\",\n        \"78\": \"Расчеты\",\n        \"79\": \"Live-help\",\n        \"80\": \"Информация\",\n        \"81\": \"Для пополнения счета необходимо ввести дополнительные данные\",\n        \"82\": \"все время\",\n        \"83\": \"ближайший час\",\n        \"84\": \"ближайшие 2 часа\",\n        \"85\": \"ближайшие 4 часа\",\n        \"87\": \"ближайшие 12 часов\",\n        \"88\": \"ближайшие 24 часа\",\n        \"89\": \"ближайшие 48 часов\",\n        \"90\": \"Логин\",\n        \"91\": \"Войти\",\n        \"92\": \"Счет\",\n        \"94\": \"Номер счета\",\n        \"95\": \"Любимые пари\",\n        \"97\": \"Снятие со счета\",\n        \"98\": \"от\",\n        \"99\": \"до\",\n        \"100\": \"Без<br>комиссии\",\n        \"101\": \"Комиссия\",\n        \"102\": \"Мгновенное<br>зачисление\",\n        \"103\": \"до {{daysCount}} рабочих<br>дней\",\n        \"104\": \"Все\",\n        \"105\": \"Победитель\",\n        \"106\": \"С правилами согласен\",\n        \"107\": \"Все исходы\",\n        \"108\": \"Внимание! Вывод средств недоступен, так как не выполнены условия предоставления бонуса. Вам осталось совершить ставки, соответствующие условиям, на сумму не менее\",\n        \"109\": \"Доступный баланс:\",\n        \"29\": \"Вход\",\n        \"19\": \"Вход\",\n        \"112\": \"Зарегистрироваться\",\n  