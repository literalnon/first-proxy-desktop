FM/GtdybfvYx14Crro/ImCrjyG8i5q8r8VarNIE7iOitTeMcAPja7fPKN0YQ8VYkMfy02DuzUrjDUmIwEZIoPB1uRkgdFIbt43q+NIMLlR98Iikh/H1t29im4RuBOeJjHZ2PVzQCVo/Bb0; xq_icm=10000; cfidsgib-w-betcity=O8RRIlsZvzrtyPmGaUJ7CSqXAW0LvriO+nh4oZNYmsMWdLOcGWV5cZ8zw0pGb9C4x5sdwfzbzZjFnFRWrM6fwWXvxEe3xojrk71gFqXrHGOZD+vBFYmAVGPpBwv1oiwzhYLdPhjdVnkI9X1dNwb6LaYKD9wrP6JKb/NKRlxt; gsscgib-w-"},{"name":"Content-Length","value":"0"}],"queryString":[{"name":"key","value":"seo_text.home_page_ru1"},{"name":"hash","value":"ae5aeea60f48813779a169e061c32f4e"},{"name":"ver","value":"55"},{"name":"csn","value":"eepugw"},{"name":"lng","value":"0"}],"headersSize":2166,"bodySize":0,"comment":""},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Server","value":"nginx"},{"name":"Date","value":"Wed, 02 Jul 2025 20:23:41 GMT"},{"name":"Content-Type","value":"application/json; charset=utf-8"},{"name":"Connection","value":"keep-alive"},{"name":"Vary","value":"Accept-Encoding"},{"name":"Access-Control-Allow-Headers","value":"Authorization"},{"name":"Access-Control-Allow-Origin","value":"https://m.betcity.ru"},{"name":"Access-Control-Allow-Credentials","value":"true"},{"name":"Expires","value":"Mon, 26 Jul 1997 05:00:00 GMT"},{"name":"Last-Modified","value":"Wed, 02 Jul 2025 20:23:24 GMT"},{"name":"Cache-Control","value":"no-store, no-cache, must-revalidate"},{"name":"Pragma","value":"no-cache"},{"name":"Strict-Transport-Security","value":"max-age=31536000"},{"name":"X-Frame-Options","value":"DENY"},{"name":"X-Content-Type-Options","value":"nosniff"},{"name":"X-XSS-Protection","value":"1; mode=block"},{"name":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"name":"Content-Length","value":"11862"}],"content":{"size":11862,"mimeType":"application/json; charset=utf-8","text":"{\"reply\":{\"text\":\"<h1>Ставки на спорт в &laquo;БЕТСИТИ&raquo;</h1>\\r\\n\\r\\n<p>Компания была основана в 2003 году. За двадцать лет она вошла в топ самых узнаваемых и надежных брендов в сфере беттинга. Достижения на сегодняшний день:</p>\\r\\n\\r\\n<ul>\\r\\n\\t<li>2019 год: премия BR Awards за &laquo;Лучший клиентский сервис&raquo;.</li>\\r\\n\\t<li>2020 год: премия BR Awards за &laquo;Лучшую линию&raquo;.</li>\\r\\n\\t<li>2020 год: титульный спонсор национального кубка страны. Турнир прошел под названием &laquo;БЕТСИТИ Кубок России&raquo;.</li>\\r\\n\\t<li>2021 год: &laquo;Премия РБ&raquo; за &laquo;Лучшее спортивное партнерство&raquo;, &laquo;Лучшие коэффициенты&raquo; и &laquo;Лучшую линию&raquo;.</li>\\r\\n\\t<li>2022 год: &laquo;Премия РБ&raquo; за &laquo;Лучший приветственный бонус&raquo; и &laquo;Лучшие коэффициенты&raquo;.</li>\\r\\n\\t<li>2023 год: премия MarSpo Awards в номинации &laquo;Лучший digital-проект в медиа&raquo;.</li>\\r\\n\\t<li>2023 год: премия &laquo;Спорт и Россия&raquo; в четырех номинациях.</li>\\r\\n\\t<li>2024 год: букмекерская компания года на премии &laquo;Спорт и Россия&raquo;.</li>\\r\\n\\t<li>2024 год: титульный партнер ФК &laquo;Динамо&raquo; Махачкала и Суперлиги России по футзалу.</li>\\r\\n\\t<li>2024 год: партнеры футбольных клубов &laquo;Урал&raquo; и &laquo;Сочи&raquo;, гандбольного клуба &laquo;Ростов-Дон&raquo;.</li>\\r\\n</ul>\\r\\n\\r\\n<p>Мы принимаем ставки более чем на 12 000 турниров по 65 видам спорта. Можем похвастаться низкой маржой и высокими коэффициентами.</p>\\r\\n\\r\\n<p>Все новые игроки получают в подарок различные бонусы. Действующие клиенты участвуют в &laquo;Программе лояльности&raquo;, а в социальных сетях регулярно проходит розыгрыш фрибетов.</p>\\r\\n\\r\\n<h2>Мобильное приложение</h2>\\r\\n\\r\\n<p>Для удобства клиентов мы принимаем ставки на различные события не только на сайте и в ППС, но и в мобильном приложении. Пользователям iOS оно доступно в AppStore.<br />\\r\\nОбладатели Android могут установить софт напрямую с официального сайта из раздела &laquo;Приложения&raquo;. Второй способ &mdash; скачать программу из наиболее популярных магазинов приложений для андроидов.&nbsp;<br />\\r\\nМы предлагаем своим клиентам современное приложение для компьютера, которое можно найти на официальном сайте в соответствующем блоке. Все приложения компании работают быстро и исправно, в них доступен тот же функционал, что и на сайте.</p>\\r\\n\\r\\n<h2>Как пройти регистрацию</h2>\\r\\n\\r\\n<p>Прежде чем начать играть на сайте &laquo;БЕТСИТИ&raquo;, необходимо пройти регистрацию и верификацию личности. Последняя позволит убедиться, что клиенту исполнилось восемнадцать лет и он может делать ставки на спорт.</p>\\r\\n\\r\\n<p>Правила регистрации требуют от игрока указания своего номера телефона, даты рождения и пароля. Последним этапом выступает согласие с обработкой персональных данных.</p>\\r\\n\\r\\n<p>Как только номер телефона подтвердится, необходимо пройти верификацию личности. Сделать это можно двумя способами:</p>\\r\\n\\r\\n<ul>\\r\\n\\t<li>Через портал Госуслуг. Игрок будет перенаправлен на сайт Единого ЦУПИС, где нужно пройти регистрацию. Этот способ идентификации предусматривает лимиты. Максимальная сумма разового пополнения/вывода &mdash; шестьдесят тысяч рублей, общий оборот в месяц не может превышать двести тысяч рублей.</li>\\r\\n\\t<li>Через загрузку документов напрямую. В этом случае потребуется сделать снимки главного разворота паспорта и страницы с регистрацией. Также нужно будет сфотографироваться с открытым документом.</li>\\r\\n</ul>\\r\\n\\r\\n<h2>Как сделать ставку</h2>\\r\\n\\r\\n<p>После регистрации можно официально играть на нашем сайте. Для этого необходимо авторизироваться и пополнить баланс в личном кабинете. Это можно сделать с помощью:</p>\\r\\n\\r\\n<ul>\\r\\n\\t<li>банковских карт;</li>\\r\\n\\t<li>электронных кошельков;</li>\\r\\n\\t<li>сотовых операторов.</li>\\r\\n</ul>\\r\\n\\r\\n<p>Зачисления приходят мгновенно. Практически все операторы работают без комиссии. Исключение &mdash; &laquo;Билайн&raquo; и TELE2 (взимают плату за услугу).</p>\\r\\n\\r\\n<p>Выплата выигрыша производится теми же способами, которыми доступно пополнение счета. Чтобы получить заработанную сумму, необходимо создать соответствующий запрос через личный кабинет. Компания оперативно рассматривает все заявки на вывод денежных средств, но в редких случаях эта процедура может занять до 72 часов.</p>\\r\\n\\r\\n<h2>Виды ставок</h2>\\r\\n\\r\\n<p>Бетторам доступны два раздела. В линии представлены события, которые еще не стартовали, в лайве &mdash; те, которые уже идут в прямом эфире.</p>\\r\\n\\r\\n<p>Для клиентов компании наши специалисты готовят самую широкую линию среди БК: мы принимаем ставки на 65 видов спорта и оперативно добавляем события. Например, линия на ведущие футбольные чемпионаты расписана сразу на несколько туров вперед.</p>\\r\\n\\r\\n<p>Аналитический отдел компании оперативно реагирует на важные спортивные мероприятия, готовит ставки на итоги сезона для известных тренеров и топовых игроков, которые перешли в новые клубы. Регулярно обновляется линия на кубки и международные турниры по ходу жеребьевки.</p>\\r\\n\\r\\n<p>В лайве для каждого события представлен матч-центр со статистикой, которая отражает ход и моменты встречи. Также на сайте и в приложении клиенты конторы могут посмотреть в прямом эфире трансляции самых разных спортивных матчей. Для бетторов доступен Live-календарь на каждый день, который расположен в одноименном разделе.</p>\\r\\n\\r\\n<p>Для удобства клиентов на сайте и в приложении расположены разделы с результатами и статистикой.</p>\\r\\n\\r\\n<p>Внутри линии на турнир также собрана дополнительная статистика к каждому событию: на последние пять матчей соперников и их личные встречи (при наличии таковых).</p>\\r\\n\\r\\n<p>Также пользователям доступна VIP-ставка, позволяющая оперировать суммой выше установленного лимита на определенное событие.</p>\\r\\n\\r\\n<h2>Широкая линия</h2>\\r\\n\\r\\n<p>Как уже было сказано, мы готовим более чем двенадцать тысяч турниров в год по 65 дисциплинам. В прематче роспись одного события может насчитывать до 1700 отдельных выборов, в лайве &mdash; до 500. Также мы предлагаем клиентам только лучшие коэффициенты. Так, маржа на ЛЧ и РПЛ в линии составляет не более 2.3-3.5%.</p>\\r\\n\\r\\n<p>Самые популярные виды спорта у наших клиентов &mdash; это:</p>\\r\\n\\r\\n<ul>\\r\\n\\t<li>Футбол: в линии представлены не только топ-первенства (АПЛ, РПЛ, Лига чемпионов, Евро и ЧМ), но и менее известные соревнования.</li>\\r\\n\\t<li>Хоккей: вниманию поклонников представлены все игры НХЛ, КХЛ, ЧМ, Олимпиады и различных национальных первенств.</li>\\r\\n\\t<li>Баскетбол: в этом разделе доступны ставки на НБА, Евролигу или Единую лигу ВТБ, а также на внутренние первенства.</li>\\r\\n\\t<li>Теннис: аналитики компании готовят широкую линию на игры Большого шлема и итоговый турнир, а также Мастерсы и Челленджеры.</li>\\r\\n\\t<li>Киберспорт: поклонники онлайн-игр могут поставить на турниры по КС 2, Доте 2, ЛоЛ, ФИФА и другим дисциплинам.</li>\\r\\n</ul>\\r\\n\\r\\n<p>В &laquo;БЕТСИТИ&raquo; вы можете оформить пари и на другие виды спорта: от единоборств и автогонок до дартса и флорбола.</p>\"},\"ok\":true,\"lng\":0,\"tnow\":1751487804}","comment":""},"redirectURL":"","headersSize":666,"bodySize":11862,"comment":""},"cache":{},"timings":{"comment":"","blocked":-1,"dns":-1,"connect":-1,"send":0,"wait":35,"receive":1,"ssl":-1},"serverIPAddress":"23.111.211.36","comment":"","time":37},{"pageref":"MyProxyHar","startedDateTime":"2025-07-02T20:23:41.393Z","request":{"method":"GET","url":"https://ad.betcity.ru/d/on_air/bets?rev=8&add=dep_events&ids_sp=&ids=19640900_18561253_19386179_17907072_19658510&md=1751498609&strip=ext&ver=55&csn=eepugw&lng=0","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Host","value":"ad.betcity.ru"},{"name":"Connection","value":"keep-alive"},{"name":"sec-ch-ua-platform","value":"\"Android\""},{"name":"User-Agent","value":"Mozilla/5.0 (Linux; Android 6.0; Nexus 5 Build/MRA58N) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Mobile Safari/537.36"},{"name":"Accept","value":"application/json