  \"180\": \"Показать события\",\n        \"181\": \"Проверка квитанции\",\n        \"182\": \"Номер квитанции:\",\n        \"183\": \"Проверочный код:\",\n        \"184\": \"Квитанция: №\",\n        \"185\": \"Принята:\",\n        \"186\": \"Рассчитана, выиграна\",\n        \"187\": \"Рассчитана, проиграна\",\n        \"188\": \"Не рассчитана\",\n        \"189\": \"Для проверки квитанции укажите ее номер и проверочный код.\",\n        \"190\": \"Смена кода доступа\",\n        \"191\": \"Коды доступа не совпадают\",\n        \"69\": \"Выберите файл\",\n        \"75\": \"Отправить файлы\",\n        \"192\": \"Сообщения\",\n        \"193\": \"Нет новых сообщений\",\n        \"194\": \"Прочитано\",\n        \"197\": \"Идентификация\",\n        \"200\": \"пунктов приёма ставок Betcity\",\n        \"201\": \"Пройти упрощённую идентификацию через \",\n        \"203\": \" если у Вас есть аккаунт на сайте Госуслуг.\",\n        \"218\": \"Выберите подходящий вариант:\",\n        \"219\": \"Адреса\",\n        \"220\": \"Подтвердить\",\n        \"223\": \" \",\n        \"224\": \"  \",\n        \"225\": \"Вы не подписаны на Push-уведомления нашего сайта. Подпишитесь и узнавайте об акциях и важных событиях первым!\",\n        \"226\": \"Вы подписаны на Push-уведомления нашего сайта. Подписка позволяет узнать об текущих акциях и важных событиях!\",\n        \"221\": \"Ваша заявка на видео звонок от оператора принята. Вы указали <b>{{type}}</b> как способ связи. Ожидайте звонка в выбранное Вами время: <b>{{date}} в {{time}}</b>\",\n        \"228\": \"Внутренняя ошибка. Пожалуйста, попробуйте загрузить документы позже.\",\n        \"122\": \"Минимум {{value}} символов\",\n        \"207\": \"Номер указанный на квитанции\",\n        \"9\": \"Кф.\",\n        \"198\": \"Завершите идентификацию одним из способов:\",\n        \"199\": \"Подтвердить регистрационные данные в одном из \",\n        \"208\": \"Ошибка в номере квитанции\",\n        \"210\": \"Для подтверждения\",\n        \"211\": \"Код указан не верно\",\n        \"212\": \"Проверить\",\n        \"213\": \"Принята\",\n        \"215\": \"Проверка квитанции\",\n        \"216\": \"Номер не обнаружен\",\n        \"217\": \"Неверный код\",\n        \"37\": \"Выбрать удобный способ связи\",\n        \"229\": \"После заказа звонка с Вами свяжется наш сотрудник и поможет пройти идентификацию.\",\n        \"204\": \"Проверка квитанции\",\n        \"206\": \"Номер квитанции\",\n        \"209\": \"Проверочный код\",\n        \"205\": \"Для проверки Вашей квитанции введите ее номер и проверочный код\",\n        \"214\": \"Для проверки Вашей квитанции введите ее номер и проверочный код в форму выше\",\n        \"78\": \"Произошла ошибка, обратитесь в службу поддержки.\",\n        \"232\": \"Акционные баллы\",\n        \"233\": \"Подробные условия и официальные правила акции:\",\n        \"231\": \"Общее число ваших баллов, набранных по акции \\\"3 белых коня\\\": \",\n        \"234\": \"Баллы по акции\",\n        \"235\": \"В вашем браузере выключены push-уведомления. Чтобы включить их откройте настройки браузера - Дополнительные настройки - Настройки контента - Оповещения - Показывать оповещения на сайтах.\",\n        \"454\": \"История активности\",\n        \"456\": \"Завершить сеанс\",\n        \"457\": \"Не удалось получить информация о вашей активности\",\n        \"458\": \"Сейчас в сети\",\n        \"459\": \"  \",\n        \"461\": \"VIP-пари находится на подтверждении\",\n        \"462\": \"VIP-пари отклонено\",\n        \"128\": \"На счет зачислено\",\n        \"61\": \"Рассчитанных пари согласно фильтра нет\",\n        \"138\": \"Выкупить пари за\",\n        \"130\": \"После выкупа на счет будет зачислено\",\n        \"460\": \"История активности — это информация о том, с каких устройств и когда Вы входили на сайт.\",\n        \"31\": \"Рассчитанных пари нет\",\n        \"463\": \"Автовыкуп пари при сумме\",\n        \"464\": \"ниже\",\n        \"465\": \"выше\",\n        \"466\": \"Включить\",\n        \"467\": \"Показывать выкуп\",\n        \"468\": \"Пари выкуплено\",\n        \"469\": \"Сумма в поле \\\"ниже\\\" не может быть выше суммы текущего значения выкупа\",\n        \"470\": \"Сумма в поле \\\"выше\\\" не может быть ниже текущего значения выкупа\",\n        \"471\": \"Сумма выкупа превышает возможный выигрыш\",\n        \"472\": \"Ставка выкуплена за \",\n        \"477\": \"Загрузить документы\",\n        \"478\": \"Загрузите цветные фотографии документов. Страницы документа должны быть видны полностью. Формат: JPG, PNG, BMP. Размер не более 5 Мб\",\n        \"479\": \"Вы сбросили платежный пароль.\",\n        \"480\": \"Новый платежный пароль будет выдан через 3 дня после сброса, в эти 3 дня невозможно снятие средств.\",\n        \"481\": \"Во избежание блокировки зеркал - не выкладывайте ссылку в публичный доступ (вконтакте, facebook, однокласники и т.п.) Добавьте в закладки для быстрого доступа к сайту.\",\n        \"485\": \"Повторно отправить код\",\n        \"486\": \"Код подтверждения\",\n        \"487\": \"Код подтверждения был отправлен Вам в СМС на указанный номер\",\n        \"490\": \"Ваш пароль в настоящее время\",\n        \"491\": \"Еще раз, для проверки\",\n        \"492\": \"Сменить пароль\",\n        \"493\": \"Получить код подтверждения\",\n        \"494\": \"Дальнейшие инструкции были отправлены на почтовый ящик\",\n        \"495\": \"Изменить e-mail\",\n        \"496\": \"Подписки\",\n        \"169\": \"Паспорт РФ\",\n        \"195\": \"Тип документа\",\n        \"497\": \"Выбрать документ\",\n        \"498\": \"Выключить\",\n        \"179\": \"Спасибо, информация принята в обработку. Результат будет выслан Вам личным сообщением.\",\n        \"499\": \"Документы загружены успешно\",\n        \"500\": \"Документы находятся на проверке\",\n        \"222\": \"Документы загружены\",\n        \"501\": \"Принять\",\n        \"503\": \"Введите код из письма\",\n        \"505\": \"Новый номер телефона\",\n        \"506\": \"E-mail не указан\",\n        \"507\": \"Добавить e-mail\",\n        \"508\": \"Номер телефона не указан\",\n        \"509\": \"Добавить номер телефона\",\n        \"161\": \"Уведомления от БЕТСИТИ\",\n        \"455\": \"История активности — это информация о том, с каких устройств и когда Вы входили на сайт.\",\n        \"511\": \"Сумма выкупа изменена.\",\n        \"512\": \"Выкуп временно недоступен.\",\n        \"514\": \"Вы уверены, что хотите отправить документы на проверку?\",\n        \"515\": \"Вы уверены, что хотите удалить фотографию?\",\n        \"77\": \"Недопустимый формат файла\",\n        \"79\": \"Необходимо выбрать хоть один файл\",\n        \"473\": \"Загрузите фото паспорта\",\n        \"474\": \"Главный разворот\",\n        \"475\": \"Разворот с регистрацией\",\n        \"502\": \"Формат ввода e-mail: имя@cервер.домен. \\r\\nНапример info@yandex.by\",\n        \"513\": \"Размер файла превышает 10 МБ\",\n        \"227\": \"Файл слишком большой, размер не должен превышать 10 Мб.\",\n        \"516\": \"Требуется загрузить Ваше фото с главным разворотом паспорта и листом бумаги, на котором написаны дата загрузки документов и номер телефона, к которому привязан данный счет и слово \\\"Бетсити\\\".\",\n        \"517\": \"Требуется загрузить Ваше фото с главным разворотом паспорта и листом бумаги, на котором написаны:\\r\\n<ol>\\r\\n  <li>слово &#171;<b>Бетсити</b>&#187;;</li>\\r\\n  <li>дата загрузки документов;</li>\\r\\n <li>номер телефона, к которому привязан данный счет</li>\\r\\n</ol>\",\n        \"476\": \"Фото с главным разворотом\",\n        \"518\": \"Находится в обработке\",\n        \"520\": \"Подтвердить e-mail\",\n        \"521\": \"E-mail подтвержден\",\n        \"522\": \"Подтвердить номер телефона\",\n        \"523\": \"Телефон подтвержден\",\n        \"524\": \"Платежный пароль\",\n        \"525\": \"Изменить его можно на странице «Реквизиты счета»\",\n        \"526\": \"Создать платежный пароль\",\n        \"527\": \"Продолжить\",\n        \"528\": \"Обеспечивает дополнительную защиту при выводе средств\",\n        \"519\": \"Проверка завершена\",\n        \"538\": \"(звонок бесплатный)\",\n        \"539\": \"Только для жителей Индии\",\n        \"529\": \"Подробная информация\",\n        \"530\": \"Платежный пароль создан\",\n        \"532\": \"Новый платежный пароль будет выдан через 3 дня после сброса, в эти 3 дня невозможно снятие средств\",\n        \"533\": \"Подтверждение e-mail\",\n        \"534\": \"Подтверждение номера\",\n        \"535\": \"Для продолжения необходимо подтвердить номер телефона или емейл\",\n        \"536\": \"Для вас был создан платежный пароль\",\n        \"537\": \"Запишите и сохраните платежный пароль. Держите его в надежном месте и не сообщайте третьим лицам, в том числе и работникам компании.\",\n        \"540\": \"Для осуществления операций по выводу средств со счета необходимо создать платежный пароль\",\n        \"541\": \"Заполнить персональные данные\",\n        \"531\": \"Обратите внимание\",\n        \"482\": \"Мужской\",\n        \"483\": \"Женский\",\n        \"484\": \"Формат номера телефона: Код страны и номер телефона (только цифры без пробелов).\",\n        \"488\": \"Сохранить номер телефона\",\n        \"489\": \"Ошибки при заполнении формы\",\n        \"504\": \"Новый e-mail\",\n        \"542\": \"Нет доступных платежных систем\",\n        \"13\": \"В ЕДИНЫЙ ЦУПИС\",\n        \"104\": \"Переход в ЕДИНЫЙ ЦУПИС\",\n        \"118\": \"Деятельность по осуществлению переводов интерактивных ставок и выплате выигрышей осуществляет «ЕДИНЫЙ ЦУПИС».\",\n        \"121\": \"Перейти в ЕДИНЫЙ ЦУПИС.\",\n        \"202\": \"ЕДИНЫЙ ЦУПИС,\",\n        \"105\": \"Перенаправление на страницу обработки платежей ЕДИНОГО ЦУПИС\",\n        \"543\": \"(бесплатные звонки из Индии)\",\n        \"544\": \"Вы хотите отменить заявку на выплату?\",\n        \"545\": \"В ЦУПИС\",\n        \"20\": \"Нет доступных платежных систем\",\n        \"108\": \"Идентификация за 5 минут\",\n        \"546\": \"Фото с паспортом, датой и номером телефона\",\n        \"547\": \"Документ отклонен\",\n        \"548\": \"Нет событий, соответствующих указанному фильтру\",\n        \"549\": \"Ожидающие\",\n        \"550\": \"Завершенные\",\n        \"551\": \"Отмененные\",\n        \"510\": \"Вы уверены, что хотите удалить привязку?\",\n        \"230\": \"Настройки выкупа пари\",\n        \"552\": \"У вас нет текущих пари\",\n        \"553\": \"Не менее {{value}} символов\",\n        \"554\": \"Отменить\",\n        \"555\": \"Пари будет автоматически выкуплено при сумме\",\n        \"558\": \"Выключить автовыкуп\",\n        \"559\": \"Вы хотите выключить автовыкуп пари?\",\n        \"560\": \"в\",\n        \"561\": \"Автовыкуп успешно включен\",\n        \"562\": \"Автовыкуп успешно выключен\",\n        \"563\": \"Автоматический выкуп пари\",\n        \"564\": \"Добавить в купон\",\n        \"565\": \"Текущих пари нет\",\n        \"566\": \"Все пари\",\n        \"567\": \"Нет пари, соответствующих выбранным фильтрам\",\n        \"557\": \"Сумма \\\"Выше\\\" должна быть больше {{amount}} {{currency}}\",\n        \"556\": \"Сумма \\\"Ниже\\\" должна быть меньше {{amount}} {{currency}}\",\n        \"568\": \"Проверяем выкуп пари\",\n        \"569\": \"Номер счета\",\n        \"570\": \"Принять\",\n        \"571\": \"Уведомления\",\n        \"573\": \"Акции и предложения\",\n        \"574\": \"Выигрыш по пари\",\n        \"575\": \"Выигрыш по ставкам\",\n        \"576\": \"Проигрыш по пари\",\n        \"577\": \"Проигрыш по ставкам\",\n        \"578\": \"Подписка на изменение баланса\",\n        \"580\": \"Общая e-mail рассылка\",\n        \"581\": \"Общая рассылка\",\n        \"583\": \"Рассылка позволяет получать наши дайджесты, информацию об акциях, быстрых играх, начислении фрибетов и полезную информацию.\",\n        \"584\": \"Вы не подписаны на нашу e-mail рассылку. Подпишитесь и получайте наши дайджесты, информацию об акциях, быстрых играх, начислении фрибетов и полезную информацию.\",\n        \"585\": \"Повторить действие можно через\",\n        \"236\": \"Подписка на PUSH-уведомления недоступна\",\n        \"579\": \"Операции по счету\",\n        \"572\": \"УВЕДОМЛЕНИЯ PUSH\",\n        \"582\": \"УВЕДОМЛЕНИЯ E-MAIL\",\n        \"586\": \"сек\",\n        \"53\": \"Фамилия\",\n        \"96\": \"<p><strong>Правила пополнения и вывода средств</strong></p>\\r\\n<ol>\\r\\n    <li>Никогда не играйте на деньги, которые вы не можете позволить себе потерять и имейте в виду, что азартные игры - это не способ зарабатывания денег. Азартные игры могут быть незаконными в той юрисдикции, в которой вы находитесь; Если это так, вы не имеете права использовать свою банковскую карту или какой-либо другой способ оплаты для совершения транзакции.</li>\\r\\n<li>Пополнить и снять денежные средства со счета можно различными способами, а именно: с использованием банковских карт, электронных кошельков, интернет-банкинга, платежных систем, терминалов самообслуживания и пр. Полный перечень способов пополнения и вывода денежных средств представлен в разделе <b>\\\"Расчеты\\\"</b>.</li>\\r\\n<li>Зачисление средств на счет происходит моментально или согласно правил платёжной системы. БК не несет ответственности за незачисление средств на игровой счет в оговоренные сроки, если такая задержка возникла по вине третьих лиц (недоступность каналов, сбои в работе платежных систем и т.п.)</li>\\r\\n<li>Запрещается использовать чужие карты и кошельки. Данные владельца кошелька или карты  должны совпадать с данными владельца игрового счета. При каждом пополнении игрового счета Клиент гарантирует, что депонируемые средства по праву принадлежат Клиенту и что эти средства не были получены каким-либо незаконным путем. Компания оставляет за собой право запросить источник происхождения средств.</li>\\r\\n<li>Компания оставляет за собой право устанавливать на игровой счет Клиента ограничения на максимальный депозит в день/месяц, максимальную сумму вывода с игрового счета в день/месяц, количество выводов средств с игрового счета в день/месяц. </li>\\r\\n<li>Все заявки на снятие средств обрабатываются круглосуточно. Компания оставляет за собой право выполнения любой заявки на вывод в течение 72 часов с момента подачи заявки. </li>\\r\\n<li>Вывод средств возможен только по тем реквизитам, по которым осуществлялось пополнение. При пополнении счета различными способами вывод средств должен быть пропорционален сумме пополнения.<br>\\r\\nКоличество заявок на вывод средств не может превышать трех в календарные сутки. По решению Букмекерской конторы в каждом конкретном случае количество запросов на вывод средств может быть изменено. При этом оплату комиссии платежных систем за вывод средств Букмекерская контора вправе возложить на клиента.</li>\\r\\n<li>Если при снятии сумма поставленных средств меньше суммы внесенных всеми способами за все время, то комиссию за вывод оплачивает клиент. В особых случаях комиссия за вывод может быть оплачена клиентом по решению БК. </li>\\r\\n<li>Компания оставляет за собой право осуществить вывод средств с игрового счета Клиента любым способом на свое усмотрение, включая определение комиссии, лимитов на количество и сумму транзакций.</li>\\r\\n<li>Компания оставляет за собой право отказать в выводе средств любым из доступных способов, если игровой счёт используется не в игровых целях, а также если суммы пополнения или вывода средств с игрового счета не соответствуют суммам размещенных ставок - на сумму внесенных средств обязательно должны быть сделаны ставки. </li>\\r\\n<li>Согласно п.17 Общих положений Компания оставляет за собой право идентификации получателя средств и право проверки используемых на счете платежных реквизитов, а именно запрашивать копии обеих сторон банковских карт, банковские выписки, скриншоты личных кабинетов платежных систем, использованных для пополнения игрового счета.<br>\\r\\nВ случае несоответствия имени Клиента и имени владельца банковской карты либо кошелька в платежной системе, БК вправе отказать в выводе средств и заблокировать счет клиента до предоставления клиентом платёжных реквизитов, соответствующих требованиям БК.</li>\\r\\n<li>     Платежный пароль:<br>\\r\\nДля осуществления операций по выводу средств со счета необходимо создать платежный пароль, для чего необходимо войти в историю счета, затем в «реквизиты счёта» и нажать «создать платежный пароль». Сразу после этого он будет отображен на том же месте в реквизитах счета. Платежный пароль будет показан единожды, поэтому необходимо сохранить полученный пароль в надежном месте, недоступном для посторонних лиц.<br>\\r\\nВ случае утраты платежного пароля необходимо подать заявку на смену платежного пароля, для чего необходимо войти в историю счета, затем в «реквизиты счета» и нажать «сбросить платежный пароль». Через 72 часа откроется возможность создать новый пароль на том же месте в реквизитах счета. В течение этих 72-х часов операции по выводу средств со счета будут недоступны.<br>\\r\\nВ целях безопасности при неправильном введении платежного пароля (более 2-х раз) возможность повторного запроса блокируется на некоторое время.</li>\\r\\n<li>Клиент несёт ответственность за дальнейшее обновление данных, представленных при регистрации. </li>\\r\\n</ol>\\r\\n\\r\\n\\r\\n<!--Никогда не играйте на деньги, которые вы не можете позволить себе потерять и имейте в виду, что азартные игры - это не способ зарабатывания денег.\\r\\nАзартные игры могут быть незаконными в той юрисдикции, в которой вы находитесь; Если это так, вы не имеете права использовать свою банковскую карту или какой-либо другой способ оплаты для совершения транзакции.\\r\\n<br>\\r\\nСнятие средств с игрового счёта возможно лишь по тем реквизитам (теми способами платежей), с которых был пополнен такой игровой счёт.<br>\\r\\n<br>\\r\\nНе рекомендуется пополнять счет с чужих электронных кошельков. Компания имеет право отказать в выводе средств на реквизиты, не принадлежащие владельцу счета.\\r\\n<br>\\r\\nСумма снятия денежных средств при пополнении счёта различными способами (электронные платёжные системы, системы денежных переводов или пункты приёма ставок) должна быть пропорциональна сумме пополнения счёта каждым из способов.\\r\\nДля клиентов, имеющих счета в белорусской валюте, в случае если счет пополнялся с помощью &laquo;WebMoney&raquo;, то снятие средств с игрового счета возможно только по &laquo;WebMoney&raquo;.<br>\\r\\n<br>\\r\\n<b>Если при снятии сумма поставленных средств меньше суммы внесенных всеми способами за все время, то комиссию за вывод оплачивает клиент.</b><br>\\r\\nВ особых случаях комиссия за вывод может быть оплачена клиентом по решению букмекерской конторы.\\r\\n<br>\\r\\nНеобходимо придерживаться следующей процедуры снятия денежных средств:\\r\\n<ul type=\\\"square\\\">\\r\\n\\t<li>выплата производится только при наличии регистрационных данных в реквизитах счета (паспортные данные: ФИО, серия, № паспорта, кем выдан, дата выдачи, дата рождения, адрес прописки).</li>\\r\\n\\t<li>в случае заявки на смену платежного пароля вывод средств со счета будет приостановлен до выдачи нового платежного пароля.</li>\\r\\n</ul>\\r\\n<br>\\r\\nПлатежный пароль:\\r\\n<ul>\\r\\n<li>Для осуществления операций по выводу средств со счета необходимо создать платежный пароль, для чего необходимо войти в <b>историю счета</b>, затем в <b>«реквизиты счёта»</b> и нажать <b>«создать платежный пароль»</b>. Сразу после этого он будет отображен на том же месте в реквизитах счета. Платежный пароль будет показан единожды, поэтому необходимо сохранить полученный пароль в надежном месте, недоступном для посторонних лиц.</li>\\r\\n<li>В случае утраты платежного пароля необходимо подать заявку на смену платежного пароля, для чего необходимо войти в <b>историю счета</b>, затем в <b>«реквизиты счета»</b> и нажать <b>«сбросить платежный пароль».</b> Через 72 часа откроется возможность создать новый пароль на том же месте в реквизитах счета. В течение этих 72-х часов операции по выводу средств со счета будут недоступны.</li>\\r\\n<li>В целях безопасности при неправильном введении платежного пароля (более 2-х раз) возможность повторного запроса блокируется на некоторое время.</li></ul>\\r\\n<br>\\r\\nВсе заявки на снятие средств обрабатываются круглосуточно.<br>\\r\\nКомпания оставляет за собой право выполнения любой заявки в течение 72 часов с момента подачи заявки.\\r\\n<br>\\r\\nКомпания оставляет за собой право осуществить вывод средств с игрового счета Клиента любым способом на свое усмотрение, включая определение комиссии, лимитов на количество и сумму транзакций.\\r\\n<br>\\r\\nКомпания оставляет за собой право идентификации получателя средств.\\r\\n<br>\\r\\n<br>\\r\\nКлиент несёт ответственность за дальнейшее обновление данных, представленных при регистрации.<br>-->\",\n        \"106\": \"В процессе перенаправления возникла ошибка! Если ошибка будет повторяться, свяжитесь со службой поддержки.\",\n        \"587\": \"Сумма \\\"Выше\\\" должна быть от {{amount}} до {{win}}{{currency}}\",\n        \"588\": \"Сумма \\\"Ниже\\\" должна быть до {{amount}}{{currency}}\",\n        \"146\": \"Текущий пароль\",\n        \"589\": \"Повторите пароль\",\n        \"590\": \"Настройки не сохранены, попробуйте ещё раз\",\n        \"591\": \"Задать вопрос о расчёте\"\n    },\n    \"ms_welcome\": {\n        \"1\": \"Добро пожаловать на мобильную версию сайта\\r\\n<b>BETCITY.RU</b>!\",\n        \"4\": \"Мобильная версия\\r\\n<br>\\r\\n<b>BETCITY.RU</b>\",\n        \"5\": \"Пропустить\",\n        \"6\": \"Начать\",\n        \"3\": \"Вы можете ознакомиться с линией, результатами и календарем в режимах live и прематч\",\n        \"7\": \"А также совершать ИНТЕРАКТИВНЫЕ СТАВКИ и ЗАКЛЮЧАТЬ ПАРИ. \",\n        \"8\": \" Добро пожаловать на мобильную версию сайта\\r\\n<b>BETCITY.RU</b>!\",\n        \"9\": \" Мобильная версия\\r\\n<br>\\r\\n<b>BETCITY.RU</b>\"\n    },\n    \"ms_cart\": {\n        \"1\": \"Ваша корзина пуста\",\n        \"5\": \"Вы можете поставить или одиночные, или экспресс, или систему.\",\n        \"6\": \"Произошли изменения в линии\",\n        \"9\": \"Превышен максимум\",\n        \"10\": \"Неверный вариант системы\",\n        \"14\": \"Корзина устарела\",\n        \"15\": \"Ошибка!\",\n        \"16\": \"Ошибка в поле суммы\",\n        \"19\": \"Изменение в линии\",\n        \"20\": \"Для постановки экспресса необходимо минимум 2 события\",\n        \"21\": \"Максимальное количество событий для экспресса\",\n        \"23\": \"Для постановки системы необходимо минимум 3 события\",\n        \"24\": \"Максимальное количество событий для системы\",\n        \"25\": \"Исход снят с приема\",\n        \"26\": \"Событие уже добавлено в корзину\",\n        \"27\": \"Изменения в кф\",\n        \"28\": \"экспресс\",\n        \"29\": \"система\",\n        \"32\": \"Согласен с изменением кф.\",\n        \"33\": \"Очистить корзину после оформления\",\n        \"35\": \"Принято\",\n        \"37\": \"Общий коэффициент\",\n        \"39\": \"Вернуться в корзину\",\n        \"40\": \"Удалить из корзины\",\n        \"42\": \"до\",\n        \"43\": \"Необходимо ввести сумму\",\n        \"44\": \"Добавьте события в корзину\",\n        \"45\": \"Тип системы\",\n        \"46\": \"вариантов:\",\n        \"49\": \"Событие успешно добавлено в корзину\",\n        \"50\": \"Прием окончен\",\n        \"3\": \"Пари с Вашего счёта невозможен\",\n        \"4\": \"Сумма по пари превышает доступный баланс\",\n        \"7\": \"Превышен суммарный максимум пари на системы\",\n        \"8\": \"Одно из событий принимается только в одиночных пари.\",\n        \"12\": \"Один из исходов принимается только в одиночных пари\",\n        \"13\": \"В пари есть зависимые события\",\n        \"18\": \"Вы не можете совершить пари. Паспортные данные указаны неверно.\",\n        \"34\": \"Оформление пари завершено\",\n        \"36\": \"Тип пари\",\n        \"41\": \"пари от\",\n        \"48\": \"Сумма больше\",\n        \"51\": \"Возможный выигрыш\",\n        \"52\": \"Ваша ставка принимается\",\n        \"53\": \"Ваша ставка отклонена\",\n        \"54\": \"Ваша ставка подтверждена\",\n        \"22\": \"Сумма больше максимально допустимой\",\n        \"55\": \"Заключение пари было прервано. Проверьте историю счета.\",\n        \"56\": \"Принято заявок на VIP\",\n        \"57\": \"Выигрыш\",\n        \"58\": \"Укажите сумму желаемого выигрыша\",\n        \"60\": \"Вернуться в линию\",\n        \"61\": \"Внимание! Обнаружена работа с корзиной в другой вкладке браузера.\",\n        \"63\": \"Достигнут максимальный размер корзины\",\n        \"64\": \"Для того чтобы заключить пари, щелкните на желаемом коэффициенте интересующего вас события\",\n        \"65\": \"С\",\n        \"66\": \"правилами\",\n        \"67\": \"согласен\",\n        \"68\": \"Вам необходимо согласиться с правилами\",\n        \"70\": \"Коэффициент\",\n        \"69\": \"Укажите сумму\",\n        \"59\": \"Минимальная сумма\",\n        \"71\": \"вар.:\",\n        \"74\": \"правилами\",\n        \"73\": \"С\",\n        \"77\": \"Назад в корзину\",\n        \"78\": \"на сумму\",\n        \"79\": \"Чтобы сформировать “экспресс”, выберите несколько независимых друг от друга событий.\",\n        \"81\": \"Чтобы сформировать ставку типа “система”, необходимо выбрать минимум три события.\",\n        \"80\": \"Чтобы сделать ставку, выберите исход события.\",\n        \"82\": \"Удалять из корзины при повторном клике на коэффициент\",\n        \"83\": \"Исход удален из корзины\",\n        \"84\": \"Только в одиночных пари\",\n        \"2\": \"Ваш счет заблокирован. Для разблокировки обратитесь на support@betcity.ru\",\n        \"72\": \"Одиночных пари\",\n        \"75\": \"Согласен\",\n        \"86\": \"Макс. пари\",\n        \"87\": \"Согласен с изм. суммы выкупа\",\n        \"88\": \"Пари оформлено\",\n        \"89\": \"Оформляем пари\",\n        \"90\": \"Выигрыш больше\",\n        \"91\": \"Включить быструю корзину\",\n        \"11\": \"Прием пари временно приостановлен\",\n        \"92\": \"Запрашивать подтверждение ставки\",\n        \"94\": \"Успешно\",\n        \"95\": \"Ошибок\",\n        \"97\": \"Ставка\",\n        \"98\": \"Ставок\",\n        \"96\": \"Ставки\",\n        \"99\": \"Идет оформление ставки\",\n        \"100\": \"Оформляется\",\n        \"101\": \"Результат\",\n        \"102\": \"Ошибка\",\n        \"103\": \"Ошибок\",\n        \"104\": \"Успешно\",\n        \"105\": \"Минимальная сумма ставки\",\n        \"30\": \"одиночная\",\n        \"106\": \"VIP-Пари оформлено\",\n        \"31\": \"Заключить пари\",\n        \"107\": \"Заявка на VIP-пари\",\n        \"108\": \"Заключите VIP-пари\",\n        \"109\": \"Дождитесь подтверждения ~10 мин.\",\n        \"110\": \"Моментальный возврат средств в случае отказа\",\n        \"112\": \"Добавить в корзину\",\n        \"113\": \"Сумма пари меньше\",\n        \"114\": \"Ошибка при формировании корзины\",\n        \"111\": \"ОК\",\n        \"62\": \"Сумма бонуса\",\n        \"38\": \"Сумма пари\",\n        \"17\": \"Сумма меньше минимально допустимой\",\n        \"47\": \"Сумма меньше\",\n        \"116\": \"Сумма пари меньше минимально допустимой\",\n        \"115\": \"Сумма\",\n        \"117\": \"VIP-заявка отправлена\",\n        \"118\": \"Отправить заявку\",\n        \"119\": \"Принято VIP-пари\",\n        \"121\": \"К событиям\",\n        \"122\": \"Одиночное пари\",\n        \"123\": \"Заявка на VIP\",\n        \"124\": \"Оформление одиночного пари завершено\",\n        \"120\": \"В корзину\",\n        \"125\": \"Принят\",\n        \"76\": \"одиночных пари\",\n        \"126\": \"событий\",\n        \"127\": \"Очищать купон после заключения пари\",\n        \"128\": \"Выводить предупреждение при очистке купона\",\n        \"129\": \"Запоминать сумму последнего пари\",\n        \"130\": \"Автоматически принимать изменения коэффициентов\",\n        \"131\": \"Настройки купона\",\n        \"132\": \"Настройки купона сохранены\",\n        \"133\": \"Одиночные\"